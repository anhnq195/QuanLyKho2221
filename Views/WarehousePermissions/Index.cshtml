@model IEnumerable<QuanLyKho2221.Models.WarehouseUserPermission>

@{
    ViewData["Title"] = "Phân quyền theo kho";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Phân quyền theo kho</h3>
            <p class="text-muted mb-0">Quản lý quyền truy cập của nhân viên tại từng kho.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Thêm phân quyền
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>STT</th>
                            <th>Nhân viên</th>
                            <th>Kho</th>
                            <th class="text-center">Xem</th>
                            <th class="text-center">Nhập</th>
                            <th class="text-center">Xuất</th>
                            <th class="text-center">Quản lý</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>
                                    <div class="fw-semibold">
                                        @(item.User?.UserName ?? "Không xác định")
                                    </div>
                                    <small class="text-muted">
                                        @(item.User?.Email ?? "")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.Warehouse?.Code ?? "")
                                    </span>
                                    <div>@(item.Warehouse?.Name ?? "Không xác định")</div>
                                </td>
                                <td class="text-center">
                                    @if (item.CanView)
                                    {
                                        <span class="badge bg-success">Có</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.CanImport)
                                    {
                                        <span class="badge bg-success">Có</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.CanExport)
                                    {
                                        <span class="badge bg-success">Có</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.CanManage)
                                    {
                                        <span class="badge bg-success">Có</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa phân quyền này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            stt++;
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Chưa có dữ liệu phân quyền.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
