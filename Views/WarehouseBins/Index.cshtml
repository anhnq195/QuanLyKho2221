@model IEnumerable<QuanLyKho2221.Models.WarehouseBin>

@{
    ViewData["Title"] = "Quản lý ô chứa";

    var shelf = ViewBag.Shelf as QuanLyKho2221.Models.WarehouseShelf;
    var bins = Model?.ToList() ?? new List<QuanLyKho2221.Models.WarehouseBin>();

    int totalBins = bins.Count;
    int totalBatches = bins.Sum(b => b.ProductBatches?.Count ?? 0);
    int occupiedBins = bins.Count(b => (b.ProductBatches?.Count ?? 0) > 0);
    int emptyBins = totalBins - occupiedBins;
}

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-box-seam text-primary"></i>
                Quản lý ô chứa
            </h2>

            <p class="text-muted mb-0">
                Kệ: <strong>@(shelf?.Name ?? "Không xác định")</strong>
            </p>
        </div>

        <div class="d-flex gap-2">
            @if (shelf != null && bins.Any())
            {
                <a asp-controller="Scanner"
                   asp-action="Labels"
                   asp-route-shelfId="@shelf.Id"
                   target="_blank"
                   class="btn btn-outline-dark">
                    <i class="bi bi-qr-code me-1"></i>
                    In tem ô chứa kệ này
                </a>
            }

            <a asp-action="Create"
               asp-route-shelfId="@shelf?.Id"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Thêm ô chứa
            </a>
        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Tổng ô chứa</p>
                            <h3 class="mb-0">@totalBins</h3>
                        </div>
                        <i class="bi bi-grid-3x3-gap text-primary fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Ô đang có lô hàng</p>
                            <h3 class="mb-0 text-success">@occupiedBins</h3>
                        </div>
                        <i class="bi bi-box-seam text-success fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Tổng số lô hàng</p>
                            <h3 class="mb-0 text-info">@totalBatches</h3>
                        </div>
                        <i class="bi bi-boxes text-info fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH Ô CHỨA -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-list-ul me-2"></i>
                Danh sách ô chứa
            </span>

            <span class="badge bg-primary">
                @totalBins ô chứa
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th style="width: 60px;">STT</th>
                        <th>Mã ô chứa</th>
                        <th>Tên ô chứa</th>
                        <th>Tầng</th>
                        <th>Số lô hàng</th>
                        <th style="width: 180px;">Sức chứa & Lấp đầy</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (bins.Any())
                    {
                        @for (int i = 0; i < bins.Count; i++)
                        {
                            var bin = bins[i];
                            int batchCount = bin.ProductBatches?.Count ?? 0;
                            int currentQty = bin.ProductBatches?.Sum(b => b.Quantity) ?? 0;
                            int maxCap = bin.MaxCapacity > 0 ? bin.MaxCapacity : 1000;
                            int percent = (int)Math.Min(100, Math.Round((double)currentQty / maxCap * 100));
                            string progressColor = percent >= 90 ? "bg-danger" : (percent >= 70 ? "bg-warning" : "bg-success");

                            <tr>
                                <td>@(i + 1)</td>

                                <td>
                                    <strong>@bin.Code</strong>
                                </td>

                                <td>@bin.Name</td>
                                <td>
                                    <span class="badge bg-primary">
                                        Tầng @bin.FloorNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-info">
                                        @batchCount lô
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">@currentQty / @maxCap</span>
                                        <strong class="@(percent >= 90 ? "text-danger" : "text-dark")">@percent%</strong>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @progressColor" style="width: @percent%;"></div>
                                    </div>
                                </td>

                                <td>
                                    @if (batchCount > 0)
                                    {
                                        <span class="badge bg-success">
                                            Đang sử dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Còn trống
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@bin.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                            Sửa
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@bin.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa ô chứa này?')">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                Xóa
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-inbox text-muted fs-1"></i>
                                <p class="text-muted mt-2 mb-3">
                                    Kệ chưa có ô chứa nào.
                                </p>

                                <a asp-action="Create"
                                   asp-route-shelfId="@shelf?.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Thêm ô chứa đầu tiên
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- QUAY LẠI -->
    <div class="mt-3">
        <a asp-controller="WarehouseShelves"
           asp-action="Index"
           asp-route-areaId="@shelf?.WarehouseAreaId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách kệ
        </a>
    </div>

</div>
