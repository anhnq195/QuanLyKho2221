@model QuanLyKho2221.Models.WarehouseArea

@{
    ViewData["Title"] = "Thêm khu vực";
}

<div class="container py-4">

    <!-- TIÊU ĐỀ -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-plus-circle text-primary me-2"></i>
            Thêm khu vực kho
        </h2>
        <p class="text-muted mb-0">
            Tạo khu vực mới để phân chia và quản lý kho hàng
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-grid text-primary me-2"></i>
                        Thông tin khu vực
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-info">
                        <i class="bi bi-building me-2"></i>
                        Kho đang thêm khu vực:
                        <strong>@ViewBag.WarehouseName</strong>
                    </div>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="WarehouseId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- MÃ KHU VỰC -->
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">
                                Mã khu vực
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Code"
                                   class="form-control"
                                   placeholder="Ví dụ: KV01, KV02" />

                            <span asp-validation-for="Code"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- TÊN KHU VỰC -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Tên khu vực
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Nhập tên khu vực" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>
                        </div>

                        <hr class="my-4" />

                        <!-- NÚT -->
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>
                                Lưu khu vực
                            </button>

                            <a asp-controller="Warehouses"
                               asp-action="Details"
                               asp-route-id="@Model.WarehouseId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Quay lại
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
