@model IEnumerable<QuanLyKho2221.Models.WarehouseShelf>

@{
    ViewData["Title"] = "Danh sách kệ";

    var area = ViewBag.Area as QuanLyKho2221.Models.WarehouseArea;
    var shelves = Model?.ToList() ?? new List<QuanLyKho2221.Models.WarehouseShelf>();
}

<div class="container-fluid py-4">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-grid text-primary me-2"></i>
                Quản lý kệ
            </h2>

            <p class="text-muted mb-0">
                Khu vực:
                <strong>@area?.Name</strong>
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="Warehouses"
               asp-action="Details"
               asp-route-id="@area?.WarehouseId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Quay lại kho
            </a>

            <a asp-action="Create"
               asp-route-areaId="@area?.Id"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Thêm kệ
            </a>

        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted mb-1">
                        Tổng số kệ
                    </div>

                    <h3 class="fw-bold text-primary mb-0">
                        @shelves.Count
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted mb-1">
                        Khu vực hiện tại
                    </div>

                    <h5 class="fw-bold mb-0">
                        @(area?.Code ?? "Chưa xác định")
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted mb-1">
                        Tên khu vực
                    </div>

                    <h5 class="fw-bold mb-0">
                        @(area?.Name ?? "Chưa xác định")
                    </h5>
                </div>
            </div>
        </div>

    </div>

    <!-- DANH SÁCH KỆ -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-ul text-primary me-2"></i>
                Danh sách kệ trong khu vực
            </h5>
        </div>

        <div class="card-body p-0">

            @if (shelves.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="ps-3">STT</th>
                                <th>Mã kệ</th>
                                <th>Tên kệ</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var stt = 1;
                            }

                            @foreach (var shelf in shelves)
                            {
                                <tr>
                                    <td class="ps-3">
                                        @stt
                                    </td>

                                    <td>
                                        <span class="fw-bold text-primary">
                                            @shelf.Code
                                        </span>
                                    </td>

                                    <td class="fw-semibold">
                                        @shelf.Name
                                    </td>

                                    <td class="text-end pe-3">
                                        <div class="d-flex justify-content-end gap-1 flex-wrap">

                                            <a asp-controller="WarehouseBins"
                                               asp-action="Index"
                                               asp-route-shelfId="@shelf.Id"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-box-seam me-1"></i>
                                                Xem ô chứa
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@shelf.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                                Sửa
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@shelf.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa kệ này?')">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                    Xóa
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>

                                stt++;
                            }

                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h6 class="text-muted mt-3">
                        Chưa có kệ nào trong khu vực này
                    </h6>

                    <p class="text-muted small">
                        Hãy thêm kệ mới để bắt đầu quản lý vị trí lưu trữ.
                    </p>

                    <a asp-action="Create"
                       asp-route-areaId="@area?.Id"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg me-1"></i>
                        Thêm kệ đầu tiên
                    </a>
                </div>
            }

        </div>
    </div>

</div>
