@model IEnumerable<QuanLyKho2221.Models.Supplier>

@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
    var suppliers = Model?.ToList() ?? new List<QuanLyKho2221.Models.Supplier>();
}

<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-truck text-primary me-2"></i>Quản lý nhà cung cấp
            </h2>
            <p class="text-muted mb-0">Quản lý thông tin liên hệ và lịch sử cung ứng của đối tác</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ExportExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel &amp; Lịch sử giao hàng
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Thêm nhà cung cấp
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                        <i class="bi bi-building-check fs-3 text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng số đối tác cung ứng</div>
                        <h3 class="fw-bold mb-0">@suppliers.Count</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-list-ul me-2"></i>Danh sách đối tác nhà cung cấp</strong>
            <span class="badge bg-primary">@suppliers.Count đối tác</span>
        </div>

        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 mb-4">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Tìm theo tên nhà cung cấp hoặc số điện thoại..." />
                    </div>
                </div>

                <div class="col-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 65px;">ID</th>
                            <th>Tên nhà cung cấp</th>
                            <th>Sản phẩm cung cấp</th>
                            <th>Số điện thoại</th>
                            <th>Email &amp; Địa chỉ</th>
                            <th class="text-end" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (suppliers.Any())
                        {
                            foreach (var item in suppliers)
                            {
                                var suppliedProducts = item.SupplierProducts?
                                    .Where(sp => sp.Product != null)
                                    .Select(sp => sp.Product!)
                                    .OrderBy(p => p.Name)
                                    .ToList() ?? new List<QuanLyKho2221.Models.Product>();

                                <tr>
                                    <td class="text-muted fw-semibold">#@item.Id</td>
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-building text-primary me-1"></i>@item.Name
                                    </td>
                                    <td style="max-width: 340px;">
                                        @if (suppliedProducts.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var p in suppliedProducts)
                                                {
                                                    <a asp-controller="Products"
                                                       asp-action="Details"
                                                       asp-route-id="@p.Id"
                                                       class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none"
                                                       title="Xem chi tiết sản phẩm @p.Name">
                                                        @(p.Code ?? $"SP-{p.Id:D4}") - @p.Name
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-dark border">
                                                Chưa gán sản phẩm (Bấm Sửa để chọn)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Phone))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace">
                                                <i class="bi bi-telephone me-1 text-success"></i>@item.Phone
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small">@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</div>
                                        <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.Address) ? "" : item.Address)</div>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có nhà cung cấp nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
