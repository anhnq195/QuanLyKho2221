@model QuanLyKho2221.Models.ImportReceipt

@{
    Layout = null;
    ViewData["Title"] = "Phiếu nhập kho";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Phiếu nhập @Model.ReceiptCode</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            padding: 30px;
        }

        .paper {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 45px;
            border: 1px solid #ddd;
        }

        h2, h3 {
            text-align: center;
        }

        .info {
            margin: 25px 0;
            line-height: 2;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #333;
            padding: 12px;
            text-align: center;
        }

        .total {
            text-align: right;
            font-weight: bold;
            margin-top: 25px;
            font-size: 18px;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 70px;
            text-align: center;
        }

            .signatures div {
                width: 40%;
            }

        .buttons {
            text-align: center;
            margin: 20px;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .paper {
                border: none;
                max-width: none;
                padding: 20px;
            }

            .buttons {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="buttons">
        <button onclick="window.print()">In / Lưu PDF</button>
        <button onclick="history.back()">Quay lại</button>
    </div>

    <div class="paper">

        <h2>QUẢN LÝ KHO HÀNG</h2>
        <h3>PHIẾU NHẬP KHO</h3>

        <div class="info">
            <p><strong>Mã phiếu:</strong> @Model.ReceiptCode</p>
            <p><strong>Ngày nhập:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            <p><strong>Nhà cung cấp:</strong> @Model.Supplier?.Name</p>
            <p><strong>Sản phẩm:</strong> @Model.Product?.Name</p>
            <p><strong>Mã sản phẩm:</strong> @Model.Product?.Code</p>
            <p><strong>Ghi chú:</strong> @(Model.Note ?? "Không có")</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>1</td>
                    <td>@Model.Product?.Name</td>
                    <td>@Model.Quantity</td>
                    <td>@Model.UnitPrice.ToString("N0") đ</td>
                    <td>@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tbody>
        </table>

        <div class="total">
            Tổng tiền: @Model.TotalAmount.ToString("N0") đ
        </div>

        <div class="signatures">
            <div>
                <strong>Người giao hàng</strong>
                <p>(Ký và ghi rõ họ tên)</p>
            </div>

            <div>
                <strong>Người nhận hàng</strong>
                <p>(Ký và ghi rõ họ tên)</p>
            </div>
        </div>

    </div>

</body>
</html>