@{
    ViewData["Title"] = "Trang chủ";
    var today = DateTime.Now;
}

<style>
    .welcome-banner {
        background: linear-gradient(120deg, #1d4ed8, #2563eb, #3b82f6);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
    }

        .welcome-banner h2 {
            font-weight: 700;
            margin-bottom: 10px;
        }

        .welcome-banner p {
            margin-bottom: 0;
            color: #dbeafe;
        }

    .welcome-icon {
        position: absolute;
        right: 35px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 100px;
        opacity: .15;
    }

    .section-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 16px;
        color: #1e293b;
    }

    .quick-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
        text-decoration: none;
        color: #1e293b;
        display: block;
        transition: all .2s ease;
    }

        .quick-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
            color: #2563eb;
            border-color: #bfdbfe;
        }

    .quick-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .quick-card h5 {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .quick-card p {
        color: #64748b;
        font-size: 12px;
        margin-bottom: 0;
    }

    .info-panel {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item i {
            font-size: 20px;
            color: #2563eb;
            width: 25px;
            text-align: center;
        }

        .info-item strong {
            display: block;
            font-size: 13px;
        }

        .info-item small {
            color: #64748b;
            font-size: 12px;
        }

    .guide-box {
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        padding: 20px;
    }

        .guide-box h5 {
            font-size: 15px;
            font-weight: 700;
            color: #1e40af;
        }

        .guide-box p {
            font-size: 13px;
            color: #475569;
            margin-bottom: 0;
        }
    /* Thu nhỏ giao diện trang chủ còn 80% */
    .container-fluid {
        zoom: 0.8;
    }
</style>

<div class="container-fluid px-0">

    <!-- WELCOME -->
    <div class="welcome-banner">
        <div class="position-relative" style="z-index: 1;">
            <div class="mb-2">
                <span class="badge bg-light text-primary">
                    <i class="bi bi-house-door me-1"></i>
                    HỆ THỐNG QUẢN LÝ KHO
                </span>
            </div>

            <h2>Chào mừng bạn đến với hệ thống!</h2>

            <p>
                Quản lý hàng hóa, nhập kho, xuất kho và theo dõi hoạt động kho hàng
                một cách thuận tiện.
            </p>

            <div class="mt-3">
                <i class="bi bi-calendar3 me-2"></i>
                Hôm nay: @today.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            </div>
        </div>

        <i class="bi bi-box-seam welcome-icon"></i>
    </div>

    <!-- QUICK ACCESS -->
    <div class="section-title">
        <i class="bi bi-grid me-2 text-primary"></i>
        Truy cập nhanh
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Products" asp-action="Index" class="quick-card">
                <div class="quick-icon bg-primary-subtle text-primary">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h5>Quản lý sản phẩm</h5>
                <p>Xem và quản lý danh sách sản phẩm trong hệ thống.</p>
                <div class="mt-3 small fw-semibold text-primary">
                    Truy cập ngay <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Imports" asp-action="Index" class="quick-card">
                <div class="quick-icon bg-success-subtle text-success">
                    <i class="bi bi-box-arrow-in-down"></i>
                </div>
                <h5>Quản lý nhập kho</h5>
                <p>Theo dõi và quản lý các phiếu nhập hàng.</p>
                <div class="mt-3 small fw-semibold text-success">
                    Truy cập ngay <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Exports" asp-action="Index" class="quick-card">
                <div class="quick-icon bg-warning-subtle text-warning">
                    <i class="bi bi-box-arrow-up"></i>
                </div>
                <h5>Quản lý xuất kho</h5>
                <p>Theo dõi và quản lý các phiếu xuất hàng.</p>
                <div class="mt-3 small fw-semibold text-warning">
                    Truy cập ngay <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Inventory" asp-action="Index" class="quick-card">
                <div class="quick-icon bg-info-subtle text-info">
                    <i class="bi bi-clipboard-data"></i>
                </div>
                <h5>Báo cáo tồn kho</h5>
                <p>Kiểm tra và theo dõi tình trạng hàng tồn kho.</p>
                <div class="mt-3 small fw-semibold text-info">
                    Truy cập ngay <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        </div>

    </div>

    <!-- INFORMATION -->
    <div class="row g-3 mb-4">

        <div class="col-lg-7">
            <div class="info-panel">
                <div class="section-title mb-2">
                    <i class="bi bi-list-check me-2 text-primary"></i>
                    Các nghiệp vụ chính
                </div>

                <div class="info-item">
                    <i class="bi bi-boxes"></i>
                    <div>
                        <strong>Quản lý lô hàng</strong>
                        <small>Theo dõi mã lô, số lượng và hạn sử dụng.</small>
                    </div>
                </div>

                <div class="info-item">
                    <i class="bi bi-building"></i>
                    <div>
                        <strong>Quản lý kho</strong>
                        <small>Quản lý kho, khu vực, kệ và vị trí lưu trữ.</small>
                    </div>
                </div>

                <div class="info-item">
                    <i class="bi bi-arrow-left-right"></i>
                    <div>
                        <strong>Điều chuyển kho</strong>
                        <small>Quản lý việc di chuyển hàng hóa giữa các kho.</small>
                    </div>
                </div>

                <div class="info-item">
                    <i class="bi bi-clipboard-check"></i>
                    <div>
                        <strong>Kiểm kê kho</strong>
                        <small>Kiểm tra và đối chiếu số lượng hàng hóa thực tế.</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="info-panel">
                <div class="section-title mb-3">
                    <i class="bi bi-info-circle me-2 text-primary"></i>
                    Thông tin hệ thống
                </div>

                <div class="guide-box mb-3">
                    <h5>
                        <i class="bi bi-shield-check me-2"></i>
                        Quản lý an toàn
                    </h5>
                    <p>
                        Hệ thống hỗ trợ phân quyền người dùng và ghi nhận
                        các hoạt động quản lý kho.
                    </p>
                </div>

                <div class="info-item">
                    <i class="bi bi-person-circle"></i>
                    <div>
                        <strong>Tài khoản hiện tại</strong>
                        <small>@(User.Identity?.Name ?? "Khách")</small>
                    </div>
                </div>

                <div class="info-item">
                    <i class="bi bi-calendar-event"></i>
                    <div>
                        <strong>Ngày truy cập</strong>
                        <small>@today.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>

                <div class="info-item">
                    <i class="bi bi-pc-display"></i>
                    <div>
                        <strong>Phiên bản hệ thống</strong>
                        <small>QuanLyKho2221 - 2026</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
