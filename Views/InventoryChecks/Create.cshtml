@model QuanLyKho2221.Models.InventoryCheckCreateViewModel

@{
    ViewData["Title"] = "Tạo phiếu kiểm kê";
    var items = Model.Items ?? new List<QuanLyKho2221.Models.InventoryCheckItemViewModel>();
    int totalSystemQuantity = items.Sum(x => x.SystemQuantity);

    // Trích xuất danh sách Kho (phần đầu của BinLocation trước dấu '/') để lọc nhanh
    var warehouseLocations = items
        .Select(x => (x.BinLocation ?? "Chưa xác định vị trí").Split('/')[0].Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
    .sticky-filter-bar {
        position: sticky;
        top: 68px;
        z-index: 800;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #e2e8f0;
    }

    .check-row.row-changed {
        background-color: #fffbeb !important;
    }

    .check-row.row-shortage {
        background-color: #fef2f2 !important;
    }

    .check-row.row-surplus {
        background-color: #f0fdf4 !important;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clipboard-check text-primary me-2"></i>Tạo phiếu kiểm kê kho
            </h2>
            <p class="text-muted mb-0">
                Kiểm đếm thực tế theo từng lô hàng và vị trí kệ — Hỗ trợ tìm kiếm tức thì &amp; quét mã nhanh cho danh sách lớn.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <form asp-action="Create" method="post" id="stocktakeForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <!-- 4 THẺ THỐNG KÊ TỨC THỜI -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <div class="card shadow-sm border-0 p-3 h-100">
                    <span class="text-muted small fw-semibold">Tổng lô / mặt hàng</span>
                    <h3 class="fw-bold text-primary mb-0">@items.Count</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card shadow-sm border-0 p-3 h-100">
                    <span class="text-muted small fw-semibold">Tổng tồn hệ thống</span>
                    <h3 class="fw-bold text-success mb-0">@totalSystemQuantity.ToString("N0")</h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card shadow-sm border-0 p-3 h-100">
                    <span class="text-muted small fw-semibold">Đang hiển thị theo bộ lọc</span>
                    <h3 class="fw-bold text-dark mb-0">
                        <span id="visibleCount">@items.Count</span> <small class="fs-6 text-muted">/ @items.Count</small>
                    </h3>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card shadow-sm border-0 p-3 h-100">
                    <span class="text-muted small fw-semibold">Số dòng có chênh lệch</span>
                    <h3 class="fw-bold text-warning mb-0" id="changedCount">0</h3>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <label asp-for="Note" class="form-label fw-bold mb-1">Ghi chú đợt kiểm kê</label>
                <input asp-for="Note" class="form-control"
                       placeholder="Ví dụ: Kiểm kê định kỳ cuối tháng / Kiểm kê đột xuất kho linh kiện..." />
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <!-- THANH TÌM KIẾM & LỌC NHANH CỐ ĐỊNH KHI CUỘN (STICKY) -->
            <div class="card-header sticky-filter-bar p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-lg-5 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white text-primary">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   id="checkSearchInput"
                                   class="form-control"
                                   placeholder="Gõ Mã SKU, Tên SP, Mã lô (LOT-...), Ô kệ hoặc bắn mã vạch (Enter để nhảy vào ô Thực tế)..."
                                   autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" id="btnClearSearch" title="Xóa từ khóa">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-3">
                        <select id="locationFilter" class="form-select">
                            <option value="ALL">-- Tất cả kho / vị trí --</option>
                            @foreach (var loc in warehouseLocations)
                            {
                                <option value="@loc">@loc</option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-3">
                        <select id="diffFilter" class="form-select">
                            <option value="ALL">Tất cả trạng thái</option>
                            <option value="CHANGED">Đang lệch (Thừa/Thiếu)</option>
                            <option value="SHORTAGE">Thiếu hàng (&lt; 0)</option>
                            <option value="SURPLUS">Thừa hàng (&gt; 0)</option>
                            <option value="MATCHED">Khớp sổ sách (= 0)</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-12 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary w-100" disabled="@(!items.Any())">
                            <i class="bi bi-save me-1"></i>Lưu phiếu
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                @if (items.Any())
                {
                    <div class="table-responsive" style="max-height: 620px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0" id="stocktakeTable">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 5;">
                                <tr>
                                    <th style="width: 65px;">STT</th>
                                    <th style="width: 130px;">Mã SKU</th>
                                    <th>Tên sản phẩm</th>
                                    <th style="width: 170px;">Mã lô</th>
                                    <th>Vị trí kho</th>
                                    <th class="text-center" style="width: 120px;">Tồn hệ thống</th>
                                    <th style="width: 155px;">Thực tế kiểm đếm</th>
                                    <th class="text-center" style="width: 110px;">Chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < items.Count; i++)
                                {
                                    var whGroup = (items[i].BinLocation ?? "Chưa xác định vị trí").Split('/')[0].Trim();
                                    var searchKey = $"{items[i].ProductCode} {items[i].ProductName} {items[i].BatchCode} {items[i].BinLocation}".ToLowerInvariant();

                                    <tr class="check-row"
                                        data-search="@searchKey"
                                        data-wh="@whGroup"
                                        data-diff="0">
                                        <td class="text-muted fw-semibold">@(i + 1)</td>

                                        <td>
                                            <a asp-controller="Products"
                                               asp-action="Details"
                                               asp-route-id="@items[i].ProductId"
                                               class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace text-decoration-none"
                                               title="Xem chi tiết sản phẩm">
                                                @(string.IsNullOrWhiteSpace(items[i].ProductCode) ? $"SP-{items[i].ProductId:D4}" : items[i].ProductCode)
                                            </a>
                                            <input type="hidden" asp-for="Items[i].ProductId" />
                                        </td>

                                        <td class="fw-semibold">
                                            <a asp-controller="Products"
                                               asp-action="Details"
                                               asp-route-id="@items[i].ProductId"
                                               class="text-dark text-decoration-none"
                                               title="Xem chi tiết sản phẩm">
                                                @items[i].ProductName
                                            </a>
                                        </td>

                                        <td>
                                            <span class="badge bg-info-subtle text-dark border font-monospace">
                                                @items[i].BatchCode
                                            </span>
                                            <input type="hidden" asp-for="Items[i].ProductBatchId" />
                                        </td>

                                        <td>
                                            <small class="text-muted">
                                                <i class="bi bi-geo-alt text-primary me-1"></i>@items[i].BinLocation
                                            </small>
                                        </td>

                                        <td class="text-center">
                                            <span class="badge bg-primary-subtle text-primary fs-6">
                                                @items[i].SystemQuantity
                                            </span>
                                            <input type="hidden" asp-for="Items[i].SystemQuantity" />
                                        </td>

                                        <td>
                                            <input asp-for="Items[i].ActualQuantity"
                                                   type="number" min="0" step="1"
                                                   class="form-control actual-quantity fw-bold"
                                                   data-system="@items[i].SystemQuantity" />
                                            <span asp-validation-for="Items[i].ActualQuantity"
                                                  class="text-danger small"></span>
                                        </td>

                                        <td class="text-center">
                                            <span class="difference fw-bold text-secondary">0</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="noFilterMatch" class="text-center text-muted py-5" style="display: none;">
                        <i class="bi bi-search fs-2 d-block mb-2"></i>
                        Không tìm thấy sản phẩm hoặc lô hàng nào khớp với điều kiện lọc hiện tại.
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p>Chưa có sản phẩm hoặc lô hàng để kiểm kê.</p>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary px-4" disabled="@(!items.Any())">
                <i class="bi bi-save me-1"></i>Lưu phiếu kiểm kê
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const searchInput = document.getElementById("checkSearchInput");
            const btnClear = document.getElementById("btnClearSearch");
            const locationFilter = document.getElementById("locationFilter");
            const diffFilter = document.getElementById("diffFilter");
            const rows = Array.from(document.querySelectorAll("#stocktakeTable tbody tr.check-row"));
            const visibleCountEl = document.getElementById("visibleCount");
            const changedCountEl = document.getElementById("changedCount");
            const noMatchEl = document.getElementById("noFilterMatch");

            function updateRowDifference(input) {
                const tr = input.closest("tr");
                const system = Number(input.dataset.system) || 0;
                const actual = Number(input.value) || 0;
                const diff = actual - system;
                const result = tr.querySelector(".difference");

                tr.dataset.diff = diff;
                tr.classList.remove("row-changed", "row-shortage", "row-surplus");

                if (diff > 0) {
                    result.textContent = "+" + diff;
                    result.className = "difference badge bg-success-subtle text-success fs-6";
                    tr.classList.add("row-surplus");
                } else if (diff < 0) {
                    result.textContent = String(diff);
                    result.className = "difference badge bg-danger-subtle text-danger fs-6";
                    tr.classList.add("row-shortage");
                } else {
                    result.textContent = "0";
                    result.className = "difference fw-bold text-secondary";
                }
            }

            function updateSummaryAndFilter() {
                const keyword = (searchInput?.value || "").toLowerCase().trim();
                const wh = locationFilter?.value || "ALL";
                const df = diffFilter?.value || "ALL";

                let visible = 0;
                let changedTotal = 0;

                rows.forEach(tr => {
                    const diff = Number(tr.dataset.diff) || 0;
                    if (diff !== 0) changedTotal++;

                    const matchKeyword = !keyword || tr.dataset.search.includes(keyword);
                    const matchWh = (wh === "ALL") || (tr.dataset.wh === wh);

                    let matchDiff = true;
                    if (df === "CHANGED") matchDiff = diff !== 0;
                    else if (df === "SHORTAGE") matchDiff = diff < 0;
                    else if (df === "SURPLUS") matchDiff = diff > 0;
                    else if (df === "MATCHED") matchDiff = diff === 0;

                    if (matchKeyword && matchWh && matchDiff) {
                        tr.style.display = "";
                        visible++;
                    } else {
                        tr.style.display = "none";
                    }
                });

                if (visibleCountEl) visibleCountEl.textContent = visible;
                if (changedCountEl) changedCountEl.textContent = changedTotal;
                if (noMatchEl) noMatchEl.style.display = (visible === 0 && rows.length > 0) ? "block" : "none";
            }

            document.querySelectorAll(".actual-quantity").forEach(input => {
                updateRowDifference(input);
                input.addEventListener("input", () => {
                    updateRowDifference(input);
                    updateSummaryAndFilter();
                });

                // Nhấn Enter trong ô số lượng sẽ quay lại ô tìm kiếm để quét/tìm sản phẩm tiếp theo
                input.addEventListener("keydown", function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        searchInput?.focus();
                        searchInput?.select();
                    }
                });
            });

            searchInput?.addEventListener("input", updateSummaryAndFilter);
            locationFilter?.addEventListener("change", updateSummaryAndFilter);
            diffFilter?.addEventListener("change", updateSummaryAndFilter);

            btnClear?.addEventListener("click", () => {
                if (searchInput) {
                    searchInput.value = "";
                    searchInput.focus();
                    updateSummaryAndFilter();
                }
            });

            // Nhấn Enter ở ô tìm kiếm: nhảy thẳng vào ô nhập Thực tế của dòng đầu tiên đang hiển thị
            searchInput?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    const firstVisibleRow = rows.find(r => r.style.display !== "none");
                    if (firstVisibleRow) {
                        const qtyInput = firstVisibleRow.querySelector(".actual-quantity");
                        if (qtyInput) {
                            qtyInput.focus();
                            qtyInput.select();
                        }
                    }
                }
            });

            updateSummaryAndFilter();
        })();
    </script>
}
