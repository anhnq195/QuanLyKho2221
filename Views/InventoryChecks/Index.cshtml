@model IEnumerable<QuanLyKho2221.Models.InventoryCheck>

@{
    ViewData["Title"] = "Kiểm kê kho";

    var checks = Model?.ToList() ?? new List<QuanLyKho2221.Models.InventoryCheck>();

    int totalChecks = checks.Count;
    int confirmedChecks = checks.Count(x => x.IsConfirmed);
    int pendingChecks = checks.Count(x => !x.IsConfirmed);
    int totalProducts = checks.Sum(x => x.Details?.Count ?? 0);
}

<div class="container-fluid py-4">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clipboard-check text-primary me-2"></i>
                Kiểm kê kho
            </h2>
            <p class="text-muted mb-0">
                Quản lý và theo dõi các phiếu kiểm kê hàng hóa
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Tạo phiếu kiểm kê
        </a>
    </div>

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 check-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng phiếu kiểm kê</p>
                        <h3 class="fw-bold mb-0">@totalChecks</h3>
                    </div>
                    <div class="check-icon bg-primary-subtle text-primary">
                        <i class="bi bi-clipboard-data"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 check-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Đã xác nhận</p>
                        <h3 class="fw-bold text-success mb-0">@confirmedChecks</h3>
                    </div>
                    <div class="check-icon bg-success-subtle text-success">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 check-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Chưa xác nhận</p>
                        <h3 class="fw-bold text-warning mb-0">@pendingChecks</h3>
                    </div>
                    <div class="check-icon bg-warning-subtle text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 check-card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Tổng dòng sản phẩm</p>
                        <h3 class="fw-bold mb-0">@totalProducts</h3>
                    </div>
                    <div class="check-icon bg-info-subtle text-info">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- TÌM KIẾM -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                <i class="bi bi-search text-primary me-2"></i>
                Tìm kiếm phiếu kiểm kê
            </h5>

            <form asp-action="Index" method="get">
                <div class="row g-3">

                    <div class="col-12 col-md-9">
                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control"
                               placeholder="Nhập mã phiếu hoặc tên người tạo..." />
                    </div>

                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Tìm kiếm
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Xóa bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- DANH SÁCH PHIẾU -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Danh sách phiếu kiểm kê</h5>
                    <p class="text-muted small mb-0">
                        Hiển thị @totalChecks phiếu kiểm kê
                    </p>
                </div>

                <span class="badge bg-primary-subtle text-primary px-3 py-2">
                    @totalChecks phiếu
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="text-center">STT</th>
                            <th>Mã phiếu</th>
                            <th>Ngày kiểm kê</th>
                            <th>Người tạo</th>
                            <th class="text-center">Sản phẩm</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (checks.Any())
                        {
                            var stt = 1;

                            foreach (var item in checks)
                            {
                                <tr>
                                    <td class="text-center text-muted">
                                        @stt
                                    </td>

                                    <td>
                                        <span class="fw-semibold text-primary">
                                            @item.CheckCode
                                        </span>
                                    </td>

                                    <td>
                                        <i class="bi bi-calendar3 text-muted me-1"></i>
                                        @item.CheckDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <i class="bi bi-person-circle text-muted me-1"></i>
                                        @item.CreatedBy
                                    </td>

                                    <td class="text-center">
                                        <span class="badge bg-info-subtle text-info">
                                            @(item.Details?.Count ?? 0) sản phẩm
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (item.IsConfirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Đã xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-dark px-3 py-2">
                                                <i class="bi bi-clock me-1"></i>
                                                Chưa xác nhận
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <strong>Chưa có phiếu kiểm kê nào</strong>
                                    <p class="small mb-3">
                                        Hãy tạo phiếu kiểm kê đầu tiên để bắt đầu.
                                    </p>

                                    <a asp-action="Create" class="btn btn-primary btn-sm">
                                        <i class="bi bi-plus-circle me-1"></i>
                                        Tạo phiếu kiểm kê
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<style>
    .check-card {
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .check-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08) !important;
        }

    .check-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .table th {
        white-space: nowrap;
        font-size: 13px;
    }

    .table td {
        font-size: 14px;
    }
</style>
