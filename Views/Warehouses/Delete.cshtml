@model QuanLyKho2221.Models.Warehouse

@{
    ViewData["Title"] = "Xóa kho";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger mb-1">
            <i class="bi bi-trash me-2"></i>
            Xóa kho hàng
        </h2>
        <p class="text-muted mb-0">
            Kiểm tra thông tin trước khi xác nhận xóa kho
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Xác nhận xóa
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Bạn có chắc chắn muốn xóa kho này không?</strong>
                <div class="small mt-1">
                    Hãy kiểm tra thông tin bên dưới trước khi tiếp tục.
                </div>
            </div>

            <div class="border rounded-3 p-3 mb-4">

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">Mã kho</div>
                        <div class="fw-bold">@Model.Code</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">Tên kho</div>
                        <div class="fw-bold">@Model.Name</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">Địa chỉ</div>
                        <div>@(Model.Address ?? "Chưa cập nhật")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">Người quản lý</div>
                        <div>@(Model.ManagerName ?? "Chưa cập nhật")</div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-muted small mb-1">Trạng thái</div>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ngừng hoạt động</span>
                        }
                    </div>

                </div>

            </div>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn btn-danger px-4"
                            onclick="return confirm('Bạn có chắc chắn muốn xóa kho này không?');">
                        <i class="bi bi-trash me-1"></i>
                        Xác nhận xóa
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>
                        Hủy
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>
