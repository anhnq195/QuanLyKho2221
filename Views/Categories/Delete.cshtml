@model QuanLyKho2221.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
        <h2 class="fw-bold mt-3 mb-1 text-danger">
            <i class="bi bi-trash me-2"></i>Xóa danh mục
        </h2>
        <p class="text-muted mb-0">Kiểm tra thông tin trước khi xác nhận xóa.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-exclamation-triangle text-warning me-2"></i>Xác nhận xóa
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-circle me-2"></i>
                Bạn có chắc chắn muốn xóa danh mục này không?
            </div>

            <div class="border rounded-3 p-3 mb-4">
                <div class="mb-3">
                    <small class="text-muted d-block">Mã danh mục</small>
                    <strong>#@Model.Id</strong>
                </div>

                <div class="mb-3">
                    <small class="text-muted d-block">Tên danh mục</small>
                    <h5 class="fw-bold mb-0">@Model.Name</h5>
                </div>

                <div>
                    <small class="text-muted d-block">Mô tả</small>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <span>@Model.Description</span>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Chưa có mô tả</span>
                    }
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Bạn chắc chắn muốn xóa danh mục này?');">
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
