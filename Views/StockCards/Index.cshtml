@model QuanLyKho2221.Controllers.StockCardReportViewModel

@{
    ViewData["Title"] = "Thẻ kho (Sổ chi tiết vật tư)";
}

<style>
    .stockcard-page .card {
        border-radius: 12px;
        transition: .2s ease;
    }

    .stockcard-page .table th,
    .stockcard-page .table td {
        padding: 10px 12px;
        vertical-align: middle;
        font-size: 13px;
    }

    .kpi-card {
        border-radius: 12px;
        padding: 16px;
        color: white;
    }

    @@media print {
        body {
            background: white !important;
            zoom: 1 !important;
            font-size: 11pt;
        }
        .sidebar, .navbar, .no-print, .btn, form {
            display: none !important;
        }
        .container-fluid, .card, .card-body {
            padding: 0 !important;
            margin: 0 !important;
            box-shadow: none !important;
            border: none !important;
        }
        .print-only {
            display: block !important;
        }
        .table {
            border: 1px solid #000 !important;
        }
        .table th, .table td {
            border: 1px solid #000 !important;
            color: #000 !important;
        }
    }

    .print-only {
        display: none;
    }
</style>

<div class="container-fluid mt-3 pb-5 stockcard-page">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 no-print">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-journal-text text-primary me-2"></i>
                Thẻ kho (Sổ chi tiết vật tư, hàng hóa)
            </h3>
            <p class="text-muted mb-0 small">
                Theo dõi chi tiết số dư đầu kỳ, biến động nhập - xuất - điều chuyển và số dư cuối kỳ theo chuẩn kế toán kho.
            </p>
        </div>

        @if (Model.Product != null)
        {
            <div class="d-flex gap-2">
                <a asp-action="ExportExcel"
                   asp-route-productId="@Model.Product.Id"
                   asp-route-fromDate="@ViewBag.FromDate"
                   asp-route-toDate="@ViewBag.ToDate"
                   asp-route-warehouseId="@ViewBag.WarehouseId"
                   class="btn btn-success btn-sm">
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    Xuất Excel
                </a>

                <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-printer me-1"></i>
                    In thẻ kho
                </button>
            </div>
        }
    </div>

    <!-- TIÊU ĐỀ IN ẤN (PRINT VIEW) -->
    <div class="print-only text-center mb-4">
        <h4 class="fw-bold mb-1">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h4>
        <p class="small mb-3">Độc lập - Tự do - Hạnh phúc</p>
        <h3 class="fw-bold text-uppercase">THẺ KHO (SỔ CHI TIẾT VẬT TƯ, HÀNG HÓA)</h3>
        <p class="mb-1">
            <strong>Tên hàng hóa:</strong> @(Model.Product?.Name ?? "N/A") | <strong>Mã SKU:</strong> @(Model.Product?.Code ?? "N/A")
        </p>
        <p class="small text-muted">
            Kỳ báo cáo: Từ @Model.FromDate.ToString("dd/MM/yyyy") đến @Model.ToDate.ToString("dd/MM/yyyy") | Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card shadow-sm mb-4 no-print">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Chọn sản phẩm <span class="text-danger">*</span></label>
                    <select name="productId" class="form-select form-select-sm" asp-items="ViewBag.Products" onchange="this.form.submit()">
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Kho lưu trữ</label>
                    <select name="warehouseId" class="form-select form-select-sm" asp-items="ViewBag.Warehouses">
                        <option value="">-- Tất cả kho --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Từ ngày</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Đến ngày</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control form-control-sm" />
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-search me-1"></i> Tra cứu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Product != null)
    {
        <!-- KPI TỔNG HỢP TRONG KỲ -->
        <div class="row g-3 mb-4 no-print">
            <div class="col-md-3 col-6">
                <div class="kpi-card bg-primary shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small opacity-75 fw-semibold">TỒN ĐẦU KỲ</div>
                            <h3 class="fw-bold mb-0">@Model.OpeningStock.ToString("N0")</h3>
                        </div>
                        <i class="bi bi-hourglass-top fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="kpi-card bg-success shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small opacity-75 fw-semibold">TỔNG NHẬP TRONG KỲ</div>
                            <h3 class="fw-bold mb-0">+@Model.TotalIn.ToString("N0")</h3>
                        </div>
                        <i class="bi bi-box-arrow-in-down fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="kpi-card bg-danger shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small opacity-75 fw-semibold">TỔNG XUẤT TRONG KỲ</div>
                            <h3 class="fw-bold mb-0">-@Model.TotalOut.ToString("N0")</h3>
                        </div>
                        <i class="bi bi-box-arrow-up fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-6">
                <div class="kpi-card bg-dark shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small opacity-75 fw-semibold">TỒN CUỐI KỲ</div>
                            <h3 class="fw-bold mb-0">@Model.ClosingStock.ToString("N0")</h3>
                        </div>
                        <i class="bi bi-boxes fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- THÔNG TIN SẢN PHẨM -->
        <div class="card shadow-sm mb-3">
            <div class="card-body p-3 bg-light rounded">
                <div class="row g-2 align-items-center small">
                    <div class="col-md-3">
                        <span class="text-muted">Mặt hàng:</span>
                        <strong class="text-primary fs-6 ms-1">@Model.Product.Name</strong>
                    </div>
                    <div class="col-md-2">
                        <span class="text-muted">Mã SKU:</span>
                        <span class="badge bg-secondary ms-1">@(Model.Product.Code ?? "Chưa có")</span>
                    </div>
                    <div class="col-md-3">
                        <span class="text-muted">Danh mục:</span>
                        <span class="fw-semibold ms-1">@(Model.Product.Category?.Name ?? "Chưa phân nhóm")</span>
                    </div>
                    <div class="col-md-2">
                        <span class="text-muted">Đơn giá tham chiếu:</span>
                        <span class="fw-semibold ms-1">@Model.Product.Price.ToString("N0") đ</span>
                    </div>
                    <div class="col-md-2 text-md-end">
                        <span class="text-muted">Tồn hiện tại kho:</span>
                        <span class="badge @(Model.Product.Quantity > 5 ? "bg-success" : "bg-danger") fs-6 ms-1">@Model.Product.Quantity</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG CHI TIẾT THẺ KHO -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-primary text-center">
                            <tr>
                                <th style="width: 140px;">Ngày giao dịch</th>
                                <th style="width: 110px;">Số chứng từ</th>
                                <th>Loại nghiệp vụ / Diễn giải</th>
                                <th style="width: 110px;">Lô hàng</th>
                                <th style="width: 130px;">Vị trí lưu trữ</th>
                                <th style="width: 90px;" class="text-success">Nhập (+)</th>
                                <th style="width: 90px;" class="text-danger">Xuất (-)</th>
                                <th style="width: 110px;" class="table-secondary">Tồn lũy kế</th>
                                <th style="width: 120px;" class="no-print">Người lập</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- DÒNG SỐ DƯ ĐẦU KỲ -->
                            <tr class="table-warning fw-bold">
                                <td class="text-center">@Model.FromDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center text-muted">-</td>
                                <td>
                                    <i class="bi bi-flag-fill text-warning me-1"></i>
                                    SỐ DƯ ĐẦU KỲ
                                </td>
                                <td class="text-center text-muted">-</td>
                                <td class="text-center text-muted">-</td>
                                <td class="text-center text-muted">-</td>
                                <td class="text-center text-muted">-</td>
                                <td class="text-center fs-6 text-dark">@Model.OpeningStock.ToString("N0")</td>
                                <td class="text-center text-muted no-print">Hệ thống</td>
                            </tr>

                            @if (!Model.Entries.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                        Không có phát sinh giao dịch nhập/xuất/điều chuyển trong kỳ này.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Entries)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@item.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border fw-bold">@item.ReceiptCode</span>
                                        </td>
                                        <td>
                                            @if (item.TransactionType.Contains("Nhập"))
                                            {
                                                <span class="badge bg-success-subtle text-success me-1">
                                                    <i class="bi bi-arrow-down-left"></i> @item.TransactionType
                                                </span>
                                            }
                                            else if (item.TransactionType.Contains("Xuất"))
                                            {
                                                <span class="badge bg-danger-subtle text-danger me-1">
                                                    <i class="bi bi-arrow-up-right"></i> @item.TransactionType
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info me-1">
                                                    <i class="bi bi-arrow-left-right"></i> @item.TransactionType
                                                </span>
                                            }
                                            <span class="small">@item.Note</span>
                                        </td>
                                        <td class="text-center small">
                                            @if (item.BatchCode != "N/A")
                                            {
                                                <span class="badge bg-primary-subtle text-primary">@item.BatchCode</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-center small text-muted">@item.Location</td>
                                        <td class="text-center fw-bold text-success">
                                            @(item.QuantityIn > 0 ? $"+{item.QuantityIn:N0}" : "-")
                                        </td>
                                        <td class="text-center fw-bold text-danger">
                                            @(item.QuantityOut > 0 ? $"-{item.QuantityOut:N0}" : "-")
                                        </td>
                                        <td class="text-center fw-bold fs-6 table-light">
                                            @item.RunningBalance.ToString("N0")
                                        </td>
                                        <td class="text-center small text-muted no-print">
                                            <i class="bi bi-person me-1"></i>@(item.CreatedBy ?? "N/A")
                                        </td>
                                    </tr>
                                }
                            }

                            <!-- DÒNG TỔNG PHÁT SINH TRONG KỲ -->
                            <tr class="table-secondary fw-bold text-center">
                                <td colspan="5" class="text-end text-uppercase pe-3">
                                    TỔNG PHÁT SINH TRONG KỲ & SỐ DƯ CUỐI KỲ:
                                </td>
                                <td class="text-success fs-6">+@Model.TotalIn.ToString("N0")</td>
                                <td class="text-danger fs-6">-@Model.TotalOut.ToString("N0")</td>
                                <td class="text-primary fs-5">@Model.ClosingStock.ToString("N0")</td>
                                <td class="no-print"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- CHỮ KÝ XÁC NHẬN KHI IN -->
        <div class="print-only mt-5">
            <div class="row text-center">
                <div class="col-4">
                    <p class="fw-bold mb-5">Người lập thẻ</p>
                    <p class="text-muted">(Ký, ghi rõ họ tên)</p>
                </div>
                <div class="col-4">
                    <p class="fw-bold mb-5">Thủ kho</p>
                    <p class="text-muted">(Ký, ghi rõ họ tên)</p>
                </div>
                <div class="col-4">
                    <p class="fw-bold mb-5">Kế toán trưởng / Quản lý kho</p>
                    <p class="text-muted">(Ký, ghi rõ họ tên)</p>
                </div>
            </div>
        </div>
    }
</div>

