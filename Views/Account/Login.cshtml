@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - Hệ thống Quản lý Kho</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
            background: #eef3f9;
            color: #1e293b;
        }

        .login-card {
            width: 100%;
            max-width: 980px;
            min-height: 560px;
            display: grid;
            grid-template-columns: 1.08fr 0.92fr;
            background: #ffffff;
            border: 1px solid #dbe3ef;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
        }

        /* BÊN TRÁI: TÔNG SÁNG XANH DƯƠNG CÔNG SỞ */
        .login-info {
            padding: 44px 46px;
            background: #f0f6ff;
            border-right: 1px solid #dbe7f7;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            background: #2563eb;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 700;
            color: #1e3a8a;
            line-height: 1.2;
        }

        .brand-sub {
            font-size: 12.5px;
            color: #64748b;
        }

        .info-main h1 {
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
            line-height: 1.35;
            margin-bottom: 12px;
        }

        .info-main p {
            color: #475569;
            font-size: 14px;
            line-height: 1.65;
            margin-bottom: 24px;
        }

        .info-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            background: #ffffff;
            border: 1px solid #dbe7f7;
            border-radius: 12px;
            padding: 12px 14px;
        }

        .info-item-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: #eff6ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .info-item h6 {
            font-size: 13.5px;
            font-weight: 600;
            color: #1e293b;
            margin: 0 0 2px;
        }

        .info-item p {
            font-size: 12.5px;
            color: #64748b;
            margin: 0;
            line-height: 1.45;
        }

        .info-footer {
            font-size: 12.5px;
            color: #64748b;
            padding-top: 16px;
            border-top: 1px solid #dbe7f7;
            display: flex;
            justify-content: space-between;
        }

        /* BÊN PHẢI: FORM TRẮNG SẠCH SẼ */
        .login-form-side {
            padding: 46px 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
        }

        .form-inner {
            width: 100%;
            max-width: 360px;
        }

        .form-title h2 {
            font-size: 25px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .form-title p {
            font-size: 13.8px;
            color: #64748b;
            margin-bottom: 28px;
        }

        .form-label {
            font-size: 13.5px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 7px;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #ffffff;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .input-group-custom:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .input-group-custom .icon {
            padding: 0 13px;
            color: #64748b;
            font-size: 16px;
        }

        .input-group-custom:focus-within .icon {
            color: #2563eb;
        }

        .input-group-custom input {
            flex: 1;
            border: none;
            background: transparent;
            padding: 12px 12px 12px 0;
            font-size: 14px;
            color: #0f172a;
            outline: none;
        }

        .btn-toggle-pass {
            border: none;
            background: transparent;
            color: #64748b;
            padding: 0 13px;
            cursor: pointer;
            font-size: 16px;
        }

        .btn-toggle-pass:hover {
            color: #1e293b;
        }

        .caps-warning {
            display: none;
            font-size: 12px;
            color: #d97706;
            margin-top: 6px;
        }

        .btn-login {
            width: 100%;
            padding: 12.5px;
            border: none;
            border-radius: 10px;
            background: #2563eb;
            color: #ffffff;
            font-size: 14.5px;
            font-weight: 600;
            margin-top: 8px;
            transition: background 0.15s ease;
        }

        .btn-login:hover {
            background: #1d4ed8;
        }

        .form-note {
            margin-top: 24px;
            text-align: center;
            color: #64748b;
            font-size: 12.5px;
        }

        @@media (max-width: 860px) {
            .login-card {
                grid-template-columns: 1fr;
                max-width: 440px;
            }

            .login-info {
                padding: 28px 26px;
                border-right: none;
                border-bottom: 1px solid #dbe7f7;
            }

            .info-list,
            .info-footer {
                display: none;
            }

            .info-main p {
                margin-bottom: 0;
            }

            .login-form-side {
                padding: 32px 26px;
            }
        }
    </style>
</head>

<body>

    <div class="login-card">

        <!-- BÊN TRÁI: THÔNG TIN HỆ THỐNG (TÔNG SÁNG) -->
        <div class="login-info">

            <div class="brand-header">
                <div class="brand-logo">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="brand-name">QUẢN LÝ KHO</div>
                    <div class="brand-sub">Hệ thống điều hành kho vận</div>
                </div>
            </div>

            <div class="info-main my-4">
                <h1>Quản lý nhập - xuất - tồn kho tập trung</h1>
                <p>
                    Theo dõi vị trí kệ chứa, kiểm soát hạn sử dụng lô hàng và đối soát sổ thẻ kho chính xác theo thời gian thực.
                </p>

                <div class="info-list">
                    <div class="info-item">
                        <div class="info-item-icon">
                            <i class="bi bi-diagram-3"></i>
                        </div>
                        <div>
                            <h6>Quản lý đa kho &amp; vị trí kệ</h6>
                            <p>Định vị hàng hóa theo Kho, Khu vực, Kệ, Tầng và Ô chứa.</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-item-icon">
                            <i class="bi bi-arrow-left-right"></i>
                        </div>
                        <div>
                            <h6>Kiểm soát phiếu nhập - xuất - điều chuyển</h6>
                            <p>Quy trình lập phiếu, phê duyệt 2 bước và tự động ghi thẻ kho.</p>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-item-icon">
                            <i class="bi bi-clipboard-data"></i>
                        </div>
                        <div>
                            <h6>Kiểm kê &amp; báo cáo Excel</h6>
                            <p>Đối soát chênh lệch thực tế và xuất báo cáo chuẩn kế toán.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-footer">
                <span>© 2026 - Hệ thống quản lý kho</span>
                <span>Phiên bản 2.0</span>
            </div>

        </div>

        <!-- BÊN PHẢI: FORM ĐĂNG NHẬP -->
        <div class="login-form-side">

            <div class="form-inner">

                <div class="form-title">
                    <h2>Đăng nhập</h2>
                    <p>Vui lòng nhập thông tin tài khoản của bạn để tiếp tục.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-3">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="usernameInput">Tên đăng nhập</label>
                        <div class="input-group-custom">
                            <span class="icon">
                                <i class="bi bi-person"></i>
                            </span>
                            <input type="text"
                                   name="username"
                                   id="usernameInput"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username"
                                   autofocus
                                   required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="passwordInput">Mật khẩu</label>
                        <div class="input-group-custom">
                            <span class="icon">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password"
                                   name="password"
                                   id="passwordInput"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password"
                                   required />
                            <button class="btn-toggle-pass"
                                    type="button"
                                    onclick="togglePassword()"
                                    aria-label="Hiện hoặc ẩn mật khẩu">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>

                        <div class="caps-warning" id="capsAlert">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Đang bật phím Caps Lock
                        </div>
                    </div>

                    <button type="submit" class="btn-login">
                        Đăng nhập
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                </form>

                <div class="form-note">
                    <i class="bi bi-shield-check text-success me-1"></i>
                    Hệ thống xác thực nội bộ an toàn
                </div>

            </div>

        </div>

    </div>

    <script>
        function togglePassword() {
            const password = document.getElementById("passwordInput");
            const eyeIcon = document.getElementById("eyeIcon");

            if (password.type === "password") {
                password.type = "text";
                eyeIcon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                password.type = "password";
                eyeIcon.classList.replace("bi-eye-slash", "bi-eye");
            }
        }

        const pwdInput = document.getElementById("passwordInput");
        const capsAlert = document.getElementById("capsAlert");

        pwdInput.addEventListener("keyup", function (e) {
            if (e.getModifierState && e.getModifierState("CapsLock")) {
                capsAlert.style.display = "block";
            } else {
                capsAlert.style.display = "none";
            }
        });
    </script>

</body>
</html>
