@model List<QuanLyKho2221.Models.ExportReceipt>
@{
    ViewData["Title"] = "Danh sách lấy hàng tối ưu lộ trình (Auto Picking List)";
}

<style>
    @@media print {
        .sidebar, .topbar, .no-print { display: none !important; }
        .main-area { margin-left: 0 !important; }
    }
</style>

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 no-print">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-signpost-split-fill text-primary me-2"></i>
                Phiếu Soạn Hàng Tối Ưu Lộ Trình Kho (Auto Picking List)
            </h3>
            <p class="text-muted small mb-0">
                Hệ thống tự động sắp xếp thứ tự điểm dừng theo chuẩn lộ trình một chiều: <strong>Kho &rarr; Khu vực &rarr; Dãy kệ &rarr; Tầng (Thấp lên cao) &rarr; Ô chứa</strong> để giảm tối đa quãng đường di chuyển của thủ kho.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm">
                <i class="bi bi-printer me-1"></i> In phiếu soạn hàng A4
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong>
                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                Lộ trình nhặt hàng (@Model.Count điểm lấy hàng • Tổng số lượng: @Model.Sum(x => x.Quantity).ToString("N0"))
            </strong>
            <span class="small text-muted">Ngày lập: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th style="width: 70px;">Chặng</th>
                        <th style="width: 220px;">Vị trí lấy hàng (Lộ trình tối ưu)</th>
                        <th style="width: 90px;">Tầng / Ô</th>
                        <th>Sản phẩm cần lấy</th>
                        <th style="width: 140px;">Mã lô & HSD</th>
                        <th style="width: 110px;">Số lượng lấy</th>
                        <th style="width: 110px;">Mã phiếu xuất</th>
                        <th style="width: 100px;">Đã nhặt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-all fs-1 text-success d-block mb-2"></i>
                                Hiện không có phiếu xuất nào đang chờ soạn hàng.
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            var r = Model[i];
                            var bin = r.ProductBatch?.WarehouseBin;
                            var shelf = bin?.WarehouseShelf;
                            var area = shelf?.WarehouseArea;
                            var wh = area?.Warehouse;

                            <tr>
                                <td class="text-center">
                                    <span class="badge rounded-pill bg-primary fs-6">#@(i + 1)</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(wh?.Name ?? "Kho")</div>
                                    <div class="small text-muted">
                                        Khu: <strong>@(area?.Code ?? "N/A")</strong> (@(area?.Name))
                                        &rarr; Kệ: <strong class="text-primary">@(shelf?.Code ?? "N/A")</strong>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark d-block mb-1">Tầng @(bin?.FloorNumber ?? 1)</span>
                                    <span class="badge bg-dark font-monospace">Ô @(bin?.Code ?? "N/A")</span>
                                </td>
                                <td>
                                    <div class="fw-bold">@r.Product?.Name</div>
                                    <div class="small text-muted font-monospace">SKU: @(r.Product?.Code ?? "N/A")</div>
                                </td>
                                <td class="text-center small">
                                    <div class="font-monospace fw-bold text-primary">@(r.ProductBatch?.BatchCode ?? "N/A")</div>
                                    <div class="text-muted">HSD: @(r.ProductBatch?.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Không có")</div>
                                </td>
                                <td class="text-center fw-bold fs-5 text-danger">
                                    @r.Quantity.ToString("N0")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border font-monospace">@r.ReceiptCode</span>
                                    <div class="small text-muted">@(r.Receiver ?? "")</div>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" style="width: 22px; height: 22px;" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
