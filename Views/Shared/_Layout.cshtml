@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var isAdmin = User.IsInRole("Admin");
    var isEmployee = User.IsInRole("Employee");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var isWarehouseSection =
        currentController == "Warehouses" ||
        currentController == "WarehouseAreas" ||
        currentController == "WarehouseShelves" ||
        currentController == "WarehouseBins" ||
        currentController == "ProductBatches";

    var isTransferSection = currentController == "WarehouseTransfers";
    var isPermissionSection =
    currentController == "WarehousePermissions";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyKho2221</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyKho2221.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --sidebar-bg: #172554;
            --sidebar-hover: rgba(255, 255, 255, 0.08);
            --page-bg: #f1f5f9;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --sidebar-width: 250px;
        }

        * {
            box-sizing: border-box;
        }

        /* Giữ nguyên kích cỡ toàn bộ website */
        html {
            zoom: 0.8;
            font-size: 14px;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            background-image:
                radial-gradient(at 0% 0%, rgba(37, 99, 235, 0.04) 0px, transparent 45%),
                radial-gradient(at 100% 0%, rgba(6, 182, 212, 0.04) 0px, transparent 45%);
            color: var(--text-main);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
            overflow-x: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0f172a 0%, #172554 65%, #1e1b4b 100%);
            color: white;
            display: flex;
            flex-direction: column;
            z-index: 1050;
            box-shadow: 6px 0 24px rgba(15, 23, 42, .18);
            transition: transform .25s ease;
        }

        .sidebar-brand {
            min-height: 70px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: 0.3px;
            color: white;
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,.1);
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #3b82f6, #06b6d4);
            border-radius: 10px;
            font-size: 20px;
            box-shadow: 0 4px 12px rgba(6, 182, 212, .35);
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 14px 12px;
        }

            .sidebar-menu::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: #475569;
                border-radius: 10px;
            }

        .menu-label {
            color: #93c5fd;
            opacity: 0.75;
            font-size: 10.5px;
            font-weight: 700;
            padding: 17px 10px 8px;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #cbd5e1;
            text-decoration: none;
            padding: 10.5px 12px;
            margin-bottom: 4px;
            border-radius: 10px;
            transition: all .2s ease;
            font-size: 13.5px;
            font-weight: 500;
            position: relative;
        }

            .sidebar-link:hover {
                background: var(--sidebar-hover);
                color: white;
                transform: translateX(3px);
            }

            .sidebar-link.active {
                background: linear-gradient(90deg, #2563eb 0%, #1d4ed8 100%);
                color: white;
                font-weight: 600;
                box-shadow: 0 6px 16px rgba(37,99,235,.35);
            }

            .sidebar-link i {
                width: 20px;
                text-align: center;
                font-size: 17px;
            }

        /* USER AREA */
        .sidebar-user {
            padding: 16px;
            border-top: 1px solid rgba(255,255,255,.1);
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(8px);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 13px;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            font-size: 17px;
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.35);
        }

        .user-name {
            font-size: 13px;
            font-weight: 700;
            word-break: break-word;
        }

        .user-role {
            font-size: 10px;
            margin-top: 3px;
        }

        /* MAIN */
        .main-area {
            margin-left: var(--sidebar-width);
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .topbar {
            min-height: 68px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .page-heading {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.2px;
            color: var(--text-main);
        }

        .topbar-subtitle {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .main-content {
            flex: 1;
            padding: 26px;
            width: 100%;
            min-width: 0;
        }

        .main-footer {
            background: white;
            text-align: center;
            padding: 14px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
            font-size: 12px;
        }

        /* CONTENT */
        .card {
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 14px;
            background: #ffffff;
            box-shadow: 0 4px 18px -2px rgba(15, 23, 42, .05);
            transition: box-shadow .2s ease, transform .2s ease;
        }

            .card:hover {
                box-shadow: 0 10px 26px -4px rgba(15, 23, 42, .08);
            }

        .card-header {
            background: white;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 700;
            padding: 14px 18px;
            border-top-left-radius: 14px !important;
            border-top-right-radius: 14px !important;
        }

        .table {
            font-size: 13px;
            margin-bottom: 0;
        }

            .table thead th {
                background: #f8fafc;
                color: #475569;
                font-weight: 700;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                white-space: nowrap;
                border-bottom: 1px solid var(--border-color);
            }

            .table th,
            .table td {
                vertical-align: middle;
                padding: 12px 14px;
                border-color: #f1f5f9;
            }

            .table tbody tr {
                transition: background-color .15s ease;
            }

                .table tbody tr:hover {
                    background: #f5f8ff;
                }

        .table-responsive {
            max-width: 100%;
            overflow-x: auto;
        }

        .btn {
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            padding: 7px 13px;
            transition: all .18s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border-color: #1d4ed8;
            box-shadow: 0 3px 10px rgba(37, 99, 235, .22);
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
                border-color: #1e40af;
                transform: translateY(-1px);
                box-shadow: 0 6px 14px rgba(37, 99, 235, .3);
            }

        .form-control,
        .form-select {
            border-radius: 7px;
            border-color: #cbd5e1;
            font-size: 13px;
            padding: 9px 11px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 .2rem rgba(37,99,235,.12);
            }

        .form-label {
            font-weight: 600;
            font-size: 13px;
            color: #334155;
        }

        /* MOBILE */
        .menu-toggle {
            display: none;
        }

        .sidebar-overlay {
            display: none;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-area {
                margin-left: 0;
                width: 100%;
            }

            .menu-toggle {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 38px;
                height: 38px;
            }

            .sidebar-overlay.show {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15,23,42,.45);
                z-index: 1040;
            }

            .main-content {
                padding: 18px;
            }

            .topbar {
                padding: 0 16px;
            }
        }

        @@media (max-width: 576px) {
            .main-content {
                padding: 12px;
            }

            .topbar {
                min-height: 58px;
            }

            .page-heading {
                font-size: 15px;
            }

            .topbar-subtitle,
            .topbar-right {
                display: none;
            }
        }
    </style>
</head>

<body>
    @if (isAuthenticated)
    {
        <aside class="sidebar" id="sidebar">
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                <span class="brand-icon"><i class="bi bi-box-seam"></i></span>
                <span>QUẢN LÝ KHO</span>
            </a>

            <div class="sidebar-menu">
                <div class="menu-label">Tổng quan</div>

                <a asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">
                    <i class="bi bi-house-door"></i> Trang chủ
                </a>

                <div class="menu-label">Quản lý hàng hóa</div>

                <a asp-controller="Products" asp-action="Index"
                   class="sidebar-link @(currentController == "Products" ? "active" : "")">
                    <i class="bi bi-box-seam"></i> Sản phẩm
                </a>

                <a asp-controller="ProductBatches" asp-action="Index"
                   class="sidebar-link @(currentController == "ProductBatches" ? "active" : "")">
                    <i class="bi bi-boxes"></i> Quản lý lô hàng
                </a>

                @if (isAdmin)
                {
                    <a asp-controller="Categories" asp-action="Index"
                       class="sidebar-link @(currentController == "Categories" ? "active" : "")">
                        <i class="bi bi-tags"></i> Danh mục
                    </a>

                    <a asp-controller="Suppliers" asp-action="Index"
                       class="sidebar-link @(currentController == "Suppliers" ? "active" : "")">
                        <i class="bi bi-truck"></i> Nhà cung cấp
                    </a>
                }

                <div class="menu-label">Nghiệp vụ kho</div>

                <a asp-controller="Imports" asp-action="Index"
                   class="sidebar-link @(currentController == "Imports" ? "active" : "")">
                    <i class="bi bi-box-arrow-in-down"></i> Nhập kho
                </a>

                <a asp-controller="Exports" asp-action="Index"
                   class="sidebar-link @(currentController == "Exports" ? "active" : "")">
                    <i class="bi bi-box-arrow-up"></i> Xuất kho
                </a>

                <a asp-controller="InventoryChecks" asp-action="Index"
                   class="sidebar-link @(currentController == "InventoryChecks" ? "active" : "")">
                    <i class="bi bi-clipboard-check"></i> Kiểm kê kho
                </a>

                <a asp-controller="Scanner" asp-action="Index"
                   class="sidebar-link @(currentController == "Scanner" ? "active" : "")">
                    <i class="bi bi-qr-code-scan"></i> Quét mã kho
                </a>

                <a asp-controller="Inventory" asp-action="Index"
                   class="sidebar-link @(currentController == "Inventory" ? "active" : "")">
                    <i class="bi bi-clipboard-data"></i> Báo cáo tồn kho
                </a>

                <a asp-controller="StockCards" asp-action="Index"
                   class="sidebar-link @(currentController == "StockCards" ? "active" : "")">
                    <i class="bi bi-journal-text"></i> Thẻ kho (Sổ vật tư)
                </a>

                <a asp-controller="Analytics" asp-action="Index"
                   class="sidebar-link @(currentController == "Analytics" ? "active" : "")">
                    <i class="bi bi-graph-up-arrow"></i> Phân tích & Vòng quay
                </a>

                <a asp-controller="WarehouseTransfers" asp-action="Index"
                   class="sidebar-link @(isTransferSection ? "active" : "")">
                    <i class="bi bi-arrow-left-right"></i> Điều chuyển kho
                </a>

                <div class="menu-label">Quản lý kho</div>

                <a asp-controller="Warehouses" asp-action="Index"
                   class="sidebar-link @(isWarehouseSection ? "active" : "")">
                    <i class="bi bi-building"></i> Quản lý kho
                </a>

                @if (isAdmin)
                {
                    <div class="menu-label">Quản trị hệ thống</div>

                    <a asp-controller="Users" asp-action="Index"
                       class="sidebar-link @(currentController == "Users" ? "active" : "")">
                        <i class="bi bi-people"></i> Quản lý tài khoản
                    </a>
                    <a asp-controller="WarehousePermissions" asp-action="Index"
                       class="sidebar-link @(isPermissionSection ? "active" : "")">
                        <i class="bi bi-shield-lock"></i> Phân quyền theo kho
                    </a>

                    <a asp-controller="ActivityLogs" asp-action="Index"
                       class="sidebar-link @(currentController == "ActivityLogs" ? "active" : "")">
                        <i class="bi bi-clock-history"></i> Nhật ký hoạt động
                    </a>

                    <a asp-controller="DataTools" asp-action="Index"
                       class="sidebar-link @(currentController == "DataTools" ? "active" : "")">
                        <i class="bi bi-database-gear"></i> Import Excel & Sao lưu
                    </a>

                    <a asp-controller="SystemTests" asp-action="Index"
                       class="sidebar-link @(currentController == "SystemTests" ? "active" : "")">
                        <i class="bi bi-patch-check"></i> Kiểm thử tự động
                    </a>
                }
            </div>

            <div class="sidebar-user">
                <div class="user-info">
                    <div class="user-avatar"><i class="bi bi-person"></i></div>
                    <div>
                        <div class="user-name">@User.Identity?.Name</div>
                        <div class="user-role">
                            @if (isAdmin)
                            {
                                <span class="badge bg-warning text-dark">ADMIN</span>
                            }
                            else if (isEmployee)
                            {
                                <span class="badge bg-light text-dark">EMPLOYEE</span>
                            }
                        </div>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
    }

    <div class="main-area">
        @if (isAuthenticated)
        {
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-primary menu-toggle"
                            type="button"
                            onclick="toggleSidebar()"
                            aria-label="Mở menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <div>
                        <div class="page-heading">@ViewData["Title"]</div>
                        <div class="topbar-subtitle">Hệ thống quản lý kho hàng</div>
                    </div>
                </div>

                <!-- TÌM KIẾM NHANH TOÀN KHO (T22 - GLOBAL SEARCH) -->
                <div class="position-relative flex-grow-1 mx-3" style="max-width: 420px;">
                    <form asp-controller="GlobalSearch" asp-action="Index" method="get" autocomplete="off">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="q" id="globalSearchInput"
                                   class="form-control bg-light border-start-0"
                                   placeholder="Tìm nhanh phiếu, SKU, lô, kệ... (Ctrl+K)" />
                        </div>
                    </form>
                    <div id="globalSearchDropdown"
                         class="dropdown-menu w-100 shadow border-0 p-1 mt-1"
                         style="max-height: 360px; overflow-y: auto;">
                    </div>
                </div>

                <div class="topbar-right">
                    <a asp-controller="Products" asp-action="StockAlerts" class="btn btn-sm btn-outline-warning text-dark" title="Trung tâm cảnh báo đặt hàng & FEFO">
                        <i class="bi bi-bell-fill text-warning"></i> Cảnh báo
                    </a>
                    <i class="bi bi-calendar3"></i>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                    <span class="badge bg-primary">ONLINE</span>
                </div>
            </header>
        }

        <main role="main" class="main-content">
            @RenderBody()
        </main>

        <footer class="main-footer">
            &copy; 2026 - QuanLyKho2221 - Hệ thống quản lý kho
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function toggleSidebar() {
            document.getElementById("sidebar")?.classList.toggle("show");
            document.getElementById("sidebarOverlay")?.classList.toggle("show");
        }

        document.querySelectorAll(".sidebar-link").forEach(link => {
            link.addEventListener("click", function() {
                if (window.innerWidth <= 992) {
                    document.getElementById("sidebar")?.classList.remove("show");
                    document.getElementById("sidebarOverlay")?.classList.remove("show");
                }
            });
        });

        // Global Search Autocomplete & Ctrl+K Shortcut (T22)
        (function () {
            const input = document.getElementById("globalSearchInput");
            const dropdown = document.getElementById("globalSearchDropdown");
            if (!input || !dropdown) return;

            let timer = null;

            function esc(s) {
                return String(s || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
            }

            input.addEventListener("input", function () {
                clearTimeout(timer);
                const q = input.value.trim();
                if (q.length < 2) {
                    dropdown.classList.remove("show");
                    return;
                }

                timer = setTimeout(async () => {
                    try {
                        const res = await fetch("/GlobalSearch/Quick?q=" + encodeURIComponent(q));
                        const data = await res.json();
                        const items = data.items || [];

                        if (items.length === 0) {
                            dropdown.innerHTML = `<div class="p-2 text-muted small text-center">Không có gợi ý nhanh. Nhấn Enter để tìm toàn bộ.</div>`;
                        } else {
                            dropdown.innerHTML = items.map(it => `
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 rounded" href="${esc(it.url)}">
                                    <i class="bi ${esc(it.icon)} fs-5"></i>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-semibold small text-truncate">${esc(it.title)}</div>
                                        <div class="text-muted" style="font-size:11px;">${esc(it.sub)}</div>
                                    </div>
                                    <span class="badge bg-light text-secondary border" style="font-size:10px;">${esc(it.category)}</span>
                                </a>
                            `).join("");
                        }
                        dropdown.classList.add("show");
                    } catch (e) { }
                }, 220);
            });

            document.addEventListener("click", function (e) {
                if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.classList.remove("show");
                }
            });

            document.addEventListener("keydown", function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                    e.preventDefault();
                    input.focus();
                    input.select();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
