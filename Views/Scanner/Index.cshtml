@{
    ViewData["Title"] = "Quét mã kho";
}

<style>
    .scanner-page {
        max-width: 760px;
        margin: 0 auto;
    }

    #reader {
        width: 100%;
        border-radius: 14px;
        overflow: hidden;
        background: #0f172a;
        min-height: 60px;
    }

    #reader video {
        border-radius: 14px;
    }

    .scan-input {
        font-size: 1.1rem;
        font-family: Consolas, monospace;
    }

    .result-card {
        border-radius: 14px;
        border: 0;
        animation: pop .25s ease;
    }

    @@keyframes pop {
        from { transform: scale(.97); opacity: .4; }
        to { transform: scale(1); opacity: 1; }
    }

    .batch-item {
        border-left: 4px solid #2563eb;
        border-radius: 10px;
        background: #fff;
    }

    .batch-item.expired { border-left-color: #dc2626; }
    .batch-item.near { border-left-color: #f59e0b; }

    .stat-pill {
        background: #f1f5f9;
        border-radius: 10px;
        padding: 8px 10px;
        text-align: center;
    }

    .stat-pill .v {
        font-size: 1.25rem;
        font-weight: 700;
    }

    .history-item {
        cursor: pointer;
    }

    .history-item:hover {
        background: #f8fafc;
    }

    @@media (max-width: 576px) {
        .scanner-page h3 { font-size: 1.25rem; }
        .action-btns .btn { flex: 1 1 45%; }
    }
</style>

<div class="container-fluid mt-3 pb-5 scanner-page">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-qr-code-scan text-primary me-2"></i>
                Quét mã kho
            </h3>
            <p class="text-muted small mb-0">
                Quét tem lô hàng, tem ô chứa hoặc mã SKU bằng camera điện thoại hoặc súng quét mã vạch.
            </p>
        </div>
    </div>

    <!-- CAMERA -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:14px;">
        <div class="card-body p-3">
            <div id="reader"></div>

            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button id="btnStart" class="btn btn-primary flex-fill">
                    <i class="bi bi-camera-video me-1"></i> Bật camera
                </button>
                <button id="btnStop" class="btn btn-outline-danger flex-fill" style="display:none;">
                    <i class="bi bi-stop-circle me-1"></i> Tắt camera
                </button>
                <select id="cameraSelect" class="form-select" style="max-width: 260px; display:none;"></select>
            </div>

            <div id="cameraError" class="alert alert-warning small mt-3 mb-0" style="display:none;"></div>

            <hr />

            <!-- NHẬP TAY / SÚNG QUÉT USB -->
            <form id="manualForm" class="input-group" autocomplete="off">
                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                <input id="manualCode" type="text" class="form-control scan-input"
                       placeholder="WMS-B12, LOT-..., SP-..., mã ô..." maxlength="100" autofocus />
                <button class="btn btn-dark" type="submit">Tra cứu</button>
            </form>
            <div class="form-text small">
                Súng quét mã vạch USB hoạt động như bàn phím — chỉ cần đặt con trỏ vào ô trên và bóp cò.
            </div>
        </div>
    </div>

    <!-- KẾT QUẢ -->
    <div id="resultArea"></div>

    <!-- LỊCH SỬ QUÉT -->
    <div class="card shadow-sm border-0 mt-3" style="border-radius:14px;">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <strong class="small"><i class="bi bi-clock-history me-1"></i> Lịch sử quét trong phiên</strong>
            <button id="btnClearHistory" class="btn btn-link btn-sm text-muted p-0">Xóa</button>
        </div>
        <ul id="historyList" class="list-group list-group-flush small">
            <li class="list-group-item text-muted text-center">Chưa quét mã nào.</li>
        </ul>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        (function () {
            const resultArea = document.getElementById('resultArea');
            const historyList = document.getElementById('historyList');
            const cameraError = document.getElementById('cameraError');
            const btnStart = document.getElementById('btnStart');
            const btnStop = document.getElementById('btnStop');
            const cameraSelect = document.getElementById('cameraSelect');
            const manualInput = document.getElementById('manualCode');

            const history = [];
            let scanner = null;
            let lastCode = '';
            let lastTime = 0;
            let busy = false;

            // Chống XSS: escape mọi dữ liệu trước khi chèn vào HTML
            function esc(value) {
                if (value === null || value === undefined) return '';
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function beep(ok) {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.frequency.value = ok ? 1200 : 300;
                    gain.gain.value = 0.15;
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + (ok ? 0.12 : 0.3));
                } catch (e) { }
                if (navigator.vibrate) navigator.vibrate(ok ? 80 : [60, 60, 60]);
            }

            function expiryBadge(b) {
                if (b.expiryStatus === 'expired')
                    return `<span class="badge bg-danger">Hết hạn ${esc(b.expiryDate)}</span>`;
                if (b.expiryStatus === 'near')
                    return `<span class="badge bg-warning text-dark">HSD ${esc(b.expiryDate)} (còn ${esc(b.daysLeft)} ngày)</span>`;
                if (b.expiryStatus === 'ok')
                    return `<span class="badge bg-success">HSD ${esc(b.expiryDate)}</span>`;
                return `<span class="badge bg-secondary">Không có HSD</span>`;
            }

            function renderBatch(b, highlight) {
                return `
                <div class="batch-item ${esc(b.expiryStatus)} shadow-sm p-3 mb-2 ${highlight ? 'border border-primary' : ''}">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                        <div>
                            <div class="fw-bold">${esc(b.productName)}</div>
                            <div class="small text-muted">SKU: ${esc(b.productCode || 'N/A')}</div>
                        </div>
                        <span class="badge bg-light text-dark border font-monospace">${esc(b.batchCode)}</span>
                    </div>
                    <div class="small mt-2"><i class="bi bi-geo-alt text-primary me-1"></i>${esc(b.location)}</div>
                    <div class="mt-2">${expiryBadge(b)}</div>
                    <div class="row g-2 mt-2">
                        <div class="col-4"><div class="stat-pill"><div class="small text-muted">Tồn</div><div class="v">${esc(b.quantity)}</div></div></div>
                        <div class="col-4"><div class="stat-pill"><div class="small text-muted">Chờ xuất</div><div class="v text-warning">${esc(b.pending)}</div></div></div>
                        <div class="col-4"><div class="stat-pill"><div class="small text-muted">Khả dụng</div><div class="v text-success">${esc(b.available)}</div></div></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-3 action-btns">
                        <a class="btn btn-sm btn-outline-primary" href="/StockCards?productId=${encodeURIComponent(b.productId)}">
                            <i class="bi bi-journal-text me-1"></i>Thẻ kho
                        </a>
                        <a class="btn btn-sm btn-outline-danger" href="/Exports/Create">
                            <i class="bi bi-box-arrow-up me-1"></i>Xuất kho
                        </a>
                        <a class="btn btn-sm btn-outline-info" href="/WarehouseTransfers/Create">
                            <i class="bi bi-arrow-left-right me-1"></i>Điều chuyển
                        </a>
                        <a class="btn btn-sm btn-outline-dark" href="/Scanner/Labels?batchIds=${encodeURIComponent(b.id)}" target="_blank">
                            <i class="bi bi-printer me-1"></i>In tem
                        </a>
                    </div>
                </div>`;
            }

            function renderResult(code, data) {
                if (!data.found) {
                    resultArea.innerHTML = `
                    <div class="card result-card shadow-sm bg-danger-subtle">
                        <div class="card-body">
                            <div class="fw-bold text-danger"><i class="bi bi-x-octagon me-1"></i>Không tìm thấy</div>
                            <div class="small mt-1">${esc(data.message)}</div>
                            <div class="small text-muted mt-1 font-monospace">Mã: ${esc(code)}</div>
                        </div>
                    </div>`;
                    return;
                }

                let header = '';
                let body = '';

                if (data.type === 'bin') {
                    const bin = data.bin;
                    const color = bin.fillPercent >= 90 ? 'bg-danger' : (bin.fillPercent >= 70 ? 'bg-warning' : 'bg-success');
                    header = `
                        <div class="fw-bold fs-5"><i class="bi bi-grid-3x3-gap text-primary me-1"></i>${esc(data.title)}</div>
                        <div class="small text-muted">${esc(bin.location)}</div>
                        <div class="d-flex justify-content-between small mt-2">
                            <span>Sức chứa: ${esc(bin.used)} / ${esc(bin.capacity)}</span><strong>${esc(bin.fillPercent)}%</strong>
                        </div>
                        <div class="progress mt-1" style="height:8px;"><div class="progress-bar ${color}" style="width:${Number(bin.fillPercent) || 0}%"></div></div>`;
                } else {
                    const p = data.product || {};
                    header = `
                        <div class="fw-bold fs-5"><i class="bi bi-box-seam text-primary me-1"></i>${esc(data.title)}</div>
                        <div class="small text-muted">${esc(p.name || '')} — Tổng tồn toàn hệ thống: <strong>${esc(p.quantity)}</strong></div>`;
                }

                if (!data.batches || data.batches.length === 0) {
                    body = `<div class="text-muted small text-center py-3">Không có lô hàng nào còn tồn.</div>`;
                } else {
                    if (data.type === 'batch' && data.batches.length > 1) {
                        body += `<div class="alert alert-info small py-2">Mã lô này đang nằm ở <strong>${data.batches.length}</strong> vị trí (do điều chuyển kho).</div>`;
                    }
                    body += data.batches.map((b, i) => renderBatch(b, data.type === 'batch' && i === 0)).join('');
                }

                resultArea.innerHTML = `
                <div class="card result-card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>${header}</div>
                            <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Đã nhận diện</span>
                        </div>
                        ${body}
                    </div>
                </div>`;
            }

            function addHistory(code, data) {
                history.unshift({ code, ok: data.found, title: data.found ? data.title : 'Không tìm thấy', time: new Date() });
                if (history.length > 15) history.pop();

                historyList.innerHTML = history.map(h => `
                    <li class="list-group-item history-item d-flex justify-content-between" data-code="${esc(h.code)}">
                        <span>
                            <i class="bi ${h.ok ? 'bi-check-circle text-success' : 'bi-x-circle text-danger'} me-1"></i>
                            <span class="font-monospace">${esc(h.code)}</span>
                            <span class="text-muted ms-1">— ${esc(h.title)}</span>
                        </span>
                        <span class="text-muted">${h.time.toLocaleTimeString('vi-VN')}</span>
                    </li>`).join('');
            }

            async function lookup(code) {
                code = (code || '').trim();
                if (!code || busy) return;

                // Bỏ qua quét trùng liên tục trong 2.5 giây
                const now = Date.now();
                if (code === lastCode && now - lastTime < 2500) return;
                lastCode = code;
                lastTime = now;

                busy = true;
                resultArea.innerHTML = `<div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm me-2"></div>Đang tra cứu ${esc(code)}...</div>`;

                try {
                    const res = await fetch('/Scanner/Lookup?code=' + encodeURIComponent(code), {
                        headers: { 'Accept': 'application/json' }
                    });

                    if (res.redirected || res.status === 401) {
                        window.location.href = '/Account/Login';
                        return;
                    }

                    const data = await res.json();
                    beep(data.found);
                    renderResult(code, data);
                    addHistory(code, data);
                } catch (e) {
                    beep(false);
                    resultArea.innerHTML = `<div class="alert alert-danger">Lỗi kết nối máy chủ khi tra cứu mã.</div>`;
                } finally {
                    busy = false;
                }
            }

            // ---------- CAMERA ----------
            function showCameraError(msg) {
                cameraError.innerHTML = msg;
                cameraError.style.display = 'block';
            }

            async function startCamera(cameraId) {
                cameraError.style.display = 'none';

                if (!window.isSecureContext) {
                    showCameraError('Trình duyệt chỉ cho phép dùng camera trên <strong>HTTPS</strong> hoặc <strong>localhost</strong>. ' +
                        'Hãy mở trang bằng địa chỉ https://... hoặc dùng ô nhập tay bên dưới.');
                    return;
                }

                if (typeof Html5Qrcode === 'undefined') {
                    showCameraError('Không tải được thư viện quét mã (cần kết nối Internet). Vui lòng dùng ô nhập tay.');
                    return;
                }

                try {
                    if (!scanner) scanner = new Html5Qrcode('reader');

                    const config = {
                        fps: 10,
                        qrbox: (w, h) => {
                            const size = Math.floor(Math.min(w, h) * 0.75);
                            return { width: size, height: Math.floor(size * 0.75) };
                        },
                        formatsToSupport: [
                            Html5QrcodeSupportedFormats.QR_CODE,
                            Html5QrcodeSupportedFormats.CODE_128,
                            Html5QrcodeSupportedFormats.CODE_39,
                            Html5QrcodeSupportedFormats.EAN_13,
                            Html5QrcodeSupportedFormats.EAN_8,
                            Html5QrcodeSupportedFormats.UPC_A
                        ]
                    };

                    const source = cameraId ? { deviceId: { exact: cameraId } } : { facingMode: 'environment' };
                    await scanner.start(source, config, decoded => lookup(decoded), () => { });

                    btnStart.style.display = 'none';
                    btnStop.style.display = '';

                    const cams = await Html5Qrcode.getCameras();
                    if (cams && cams.length > 1) {
                        cameraSelect.innerHTML = cams.map(c => `<option value="${esc(c.id)}">${esc(c.label || 'Camera')}</option>`).join('');
                        if (cameraId) cameraSelect.value = cameraId;
                        cameraSelect.style.display = '';
                    }
                } catch (err) {
                    showCameraError('Không thể mở camera: ' + esc(err && err.message ? err.message : err) +
                        '. Hãy kiểm tra quyền truy cập camera của trình duyệt.');
                }
            }

            async function stopCamera() {
                if (scanner && scanner.isScanning) {
                    await scanner.stop();
                }
                btnStart.style.display = '';
                btnStop.style.display = 'none';
                cameraSelect.style.display = 'none';
            }

            btnStart.addEventListener('click', () => startCamera());
            btnStop.addEventListener('click', stopCamera);
            cameraSelect.addEventListener('change', async () => {
                await stopCamera();
                startCamera(cameraSelect.value);
            });

            // ---------- NHẬP TAY / SÚNG QUÉT ----------
            document.getElementById('manualForm').addEventListener('submit', e => {
                e.preventDefault();
                lastCode = ''; // cho phép tra lại cùng mã khi nhập tay
                lookup(manualInput.value);
                manualInput.select();
            });

            historyList.addEventListener('click', e => {
                const li = e.target.closest('.history-item');
                if (li) {
                    lastCode = '';
                    lookup(li.dataset.code);
                }
            });

            document.getElementById('btnClearHistory').addEventListener('click', () => {
                history.length = 0;
                historyList.innerHTML = '<li class="list-group-item text-muted text-center">Chưa quét mã nào.</li>';
            });

            // Hỗ trợ mở trực tiếp: /Scanner?code=WMS-B12
            const qs = new URLSearchParams(location.search).get('code');
            if (qs) lookup(qs);

            window.addEventListener('beforeunload', () => { if (scanner && scanner.isScanning) scanner.stop(); });
        })();
    </script>
}

