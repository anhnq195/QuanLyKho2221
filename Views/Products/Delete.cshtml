@model QuanLyKho2221.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    bool canDelete = ViewBag.CanDelete == true;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-danger mb-1">
                <i class="bi bi-trash me-2"></i>Xóa sản phẩm
            </h2>
            <p class="text-muted mb-0">
                Kiểm tra thông tin trước khi thực hiện xóa.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-0">

        <div class="card-header">
            <i class="bi bi-info-circle me-2"></i>Thông tin sản phẩm
        </div>

        <div class="card-body p-4">

            @if (canDelete)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Bạn có chắc chắn muốn xóa sản phẩm này?</strong>
                    <p class="mb-0 mt-2">
                        Thao tác này không thể hoàn tác.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="bi bi-shield-exclamation me-2"></i>
                    <strong>Không thể xóa sản phẩm!</strong>
                    <p class="mb-0 mt-2">@ViewBag.DeleteWarning</p>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered align-middle">

                    <tbody>
                        <tr>
                            <th style="width: 30%">Mã sản phẩm</th>
                            <td>
                                <span class="badge bg-secondary">
                                    @Model.Code
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Tên sản phẩm</th>
                            <td><strong>@Model.Name</strong></td>
                        </tr>

                        <tr>
                            <th>Danh mục</th>
                            <td>
                                @(Model.Category?.Name ?? "Chưa phân loại")
                            </td>
                        </tr>

                        <tr>
                            <th>Số lượng tồn</th>
                            <td>
                                @if (Model.Quantity <= 0)
                                {
                                    <span class="badge bg-danger">
                                        @Model.Quantity - Hết hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @Model.Quantity
                                    </span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>Đơn giá</th>
                            <td>@Model.Price.ToString("N0") VNĐ</td>
                        </tr>

                        <tr>
                            <th>Ngày tạo</th>
                            <td>@Model.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    </tbody>

                </table>
            </div>

            <hr class="my-4" />

            <div class="d-flex flex-wrap gap-2">

                @if (canDelete)
                {
                    <form asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>
                            Xác nhận xóa
                        </button>
                    </form>
                }

                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i>
                    Quay lại
                </a>

            </div>

        </div>
    </div>
</div>
