@model IEnumerable<QuanLyKho2221.Models.Product>

@{
    ViewData["Title"] = "Trung tâm Cảnh báo Kho & FEFO";

    var products = Model?.ToList() ?? new List<QuanLyKho2221.Models.Product>();
    var expiryBatches = ViewBag.ExpiryBatches as List<QuanLyKho2221.Models.ProductBatch>
                        ?? new List<QuanLyKho2221.Models.ProductBatch>();

    var outOfStock = products.Count(p => p.Quantity <= 0);
    var lowStock = products.Count(p => p.Quantity > 0 && p.Quantity <= 5);
    int expiredCount = ViewBag.ExpiredCount ?? 0;
    int nearExpiryCount = ViewBag.NearExpiryCount ?? 0;
    const int SafeStockTarget = 20;
}

<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bell-fill text-warning me-2"></i>
                Trung tâm Cảnh báo Đặt hàng (Auto Reorder) & Hạn dùng (FEFO)
            </h2>
            <p class="text-muted mb-0">
                Tự động phát hiện mặt hàng chạm ngưỡng tồn tối thiểu để đặt hàng bổ sung và nhắc xuất trước các lô sắp hết hạn.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Imports" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-down me-1"></i> Nhập hàng bổ sung
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quản lý sản phẩm
            </a>
        </div>
    </div>

    <!-- 4 THẺ KPI CẢNH BÁO -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 p-3">
                        <i class="bi bi-x-octagon text-danger fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đã hết hàng (0)</div>
                        <h3 class="fw-bold text-danger mb-0">@outOfStock</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-warning bg-opacity-10 p-3">
                        <i class="bi bi-Cart-plus text-warning fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Chạm mức tối thiểu (1–5)</div>
                        <h3 class="fw-bold text-warning mb-0">@lowStock</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 p-3">
                        <i class="bi bi-hourglass-split text-info fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Lô cận date (&le; 30 ngày)</div>
                        <h3 class="fw-bold text-info mb-0">@nearExpiryCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-dark bg-opacity-10 p-3">
                        <i class="bi bi-calendar-x text-dark fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Lô đã quá hạn</div>
                        <h3 class="fw-bold text-dark mb-0">@expiredCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS CHUYỂN ĐỔI -->
    <ul class="nav nav-pills mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" data-bs-toggle="pill" data-bs-target="#reorder-pane" type="button">
                <i class="bi bi-cart-check me-1"></i>
                1. Đề xuất Đặt hàng bổ sung (Auto Reorder)
                <span class="badge bg-danger ms-1">@products.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" data-bs-toggle="pill" data-bs-target="#fefo-pane" type="button">
                <i class="bi bi-clock-history me-1"></i>
                2. Cảnh báo Hạn sử dụng Lô hàng (FEFO)
                <span class="badge bg-warning text-dark ms-1">@expiryBatches.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- TAB 1: AUTO REORDER -->
        <div class="tab-pane fade show active" id="reorder-pane">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <strong>
                        <i class="bi bi-arrow-repeat text-primary me-1"></i>
                        Danh sách mặt hàng chạm ngưỡng định mức tối thiểu (&le; 5) — Định mức an toàn: @SafeStockTarget
                    </strong>
                    <input type="text" id="searchAlert" class="form-control form-control-sm" style="max-width:260px;" placeholder="Lọc theo tên hoặc mã SKU..." />
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="alertTable">
                        <thead class="table-light">
                            <tr>
                                <th>Mã SKU</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th class="text-center">Tồn hiện tại</th>
                                <th class="text-center">Định mức an toàn</th>
                                <th class="text-center text-primary">Đề xuất đặt bù</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác nhanh</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (products.Any())
                            {
                                foreach (var item in products)
                                {
                                    int reorderQty = Math.Max(10, SafeStockTarget - Math.Max(0, item.Quantity));
                                    <tr>
                                        <td><span class="badge bg-secondary font-monospace">@(item.Code ?? "N/A")</span></td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td>@(item.Category?.Name ?? "Chưa phân loại")</td>
                                        <td class="text-center fw-bold @(item.Quantity <= 0 ? "text-danger" : "text-warning")">@item.Quantity</td>
                                        <td class="text-center text-muted">@SafeStockTarget</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary-subtle text-primary fs-6">+@reorderQty</span>
                                        </td>
                                        <td>
                                            @if (item.Quantity <= 0)
                                            {
                                                <span class="badge bg-danger">Hết hàng — Khẩn cấp</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Sắp hết hàng</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Imports" asp-action="Create" class="btn btn-sm btn-primary">
                                                <i class="bi bi-plus-circle me-1"></i>Nhập bổ sung
                                            </a>
                                            <a asp-controller="StockCards" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-secondary">
                                                Thẻ kho
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <i class="bi bi-check-circle text-success fs-1"></i>
                                        <p class="text-muted mt-2 mb-0">Tất cả mặt hàng đều đạt trên định mức tồn tối thiểu.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: CẢNH BÁO HẠN SỬ DỤNG FEFO -->
        <div class="tab-pane fade" id="fefo-pane">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <strong>
                        <i class="bi bi-calendar-event text-danger me-1"></i>
                        Các lô hàng còn tồn kho đã hết hạn hoặc sắp hết hạn trong 30 ngày tới (Quy tắc FEFO)
                    </strong>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã lô</th>
                                <th>Sản phẩm</th>
                                <th>Vị trí lưu kho</th>
                                <th>Hạn sử dụng</th>
                                <th class="text-center">Số ngày còn lại</th>
                                <th class="text-center">Tồn lô</th>
                                <th class="text-end">Hành động khuyến nghị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (expiryBatches.Any())
                            {
                                foreach (var b in expiryBatches)
                                {
                                    int daysLeft = (b.ExpiryDate!.Value.Date - DateTime.Today).Days;
                                    bool isExpired = daysLeft < 0;
                                    <tr class="@(isExpired ? "table-danger" : "")">
                                        <td class="font-monospace fw-bold">@b.BatchCode</td>
                                        <td class="fw-semibold">@b.Product?.Name</td>
                                        <td class="small text-muted">
                                            @b.WarehouseBin?.WarehouseShelf?.WarehouseArea?.Warehouse?.Name ›
                                            @b.WarehouseBin?.WarehouseShelf?.Name › Ô @b.WarehouseBin?.Code
                                        </td>
                                        <td>@b.ExpiryDate.Value.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">
                                            @if (isExpired)
                                            {
                                                <span class="badge bg-danger">Quá hạn @Math.Abs(daysLeft) ngày</span>
                                            }
                                            else if (daysLeft == 0)
                                            {
                                                <span class="badge bg-danger">Hết hạn hôm nay</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Còn @daysLeft ngày</span>
                                            }
                                        </td>
                                        <td class="text-center fw-bold">@b.Quantity</td>
                                        <td class="text-end">
                                            @if (!isExpired)
                                            {
                                                <a asp-controller="Exports" asp-action="Create" class="btn btn-sm btn-success">
                                                    <i class="bi bi-box-arrow-up me-1"></i>Ưu tiên xuất FEFO
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Đã khóa xuất tự động</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="bi bi-shield-check text-success fs-1"></i>
                                        <p class="text-muted mt-2 mb-0">Không có lô hàng nào hết hạn hoặc cận date trong 30 ngày tới.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("searchAlert")?.addEventListener("input", function () {
            const keyword = this.value.toLowerCase().trim();
            document.querySelectorAll("#alertTable tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(keyword) ? "" : "none";
            });
        });
    </script>
}
